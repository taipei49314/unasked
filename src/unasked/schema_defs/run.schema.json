{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.unasked.dev/v0.1/run.schema.json",
  "title": "UNASKED investigation run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "status",
    "target",
    "protocol",
    "model",
    "tools",
    "context_manifest_hash",
    "knowledge_boundary_hash"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "run_id": { "$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/identifier" },
    "created_at": { "$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/timestamp" },
    "completed_at": { "$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/timestamp" },
    "status": {
      "enum": [
        "CREATED",
        "OBSERVING",
        "INVESTIGATING",
        "CHALLENGING",
        "REPLAYING",
        "COMPLETED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_commit", "snapshot_hash"],
      "properties": {
        "repository_url": { "type": "string", "minLength": 1 },
        "repository_commit": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "snapshot_hash": { "$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/sha256" },
        "submodules_hash": { "$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/sha256" },
        "dependency_lock_hash": { "$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/sha256" },
        "ci_metadata_hash": { "$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/sha256" }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256", "frozen_at"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/sha256" },
        "frozen_at": { "$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/timestamp" }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "name"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/toolVersion" }
    },
    "context_manifest_hash": { "$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/sha256" },
    "knowledge_boundary_hash": { "$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/sha256" },
    "budget_policy_hash": { "$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/sha256" },
    "trial_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registration_id",
        "suite_id",
        "case_id",
        "variant",
        "preregistration_hash",
        "manifest_hash"
      ],
      "properties": {
        "registration_id": { "$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/identifier" },
        "suite_id": { "$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/identifier" },
        "case_id": { "$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/identifier" },
        "variant": {
          "enum": [
            "deterministic-detectors-only",
            "read-only-llm-reviewer",
            "llm-tools-no-experiment-gate",
            "experiment-loop-without-falsifier",
            "full-evidence-gated-system"
          ]
        },
        "preregistration_hash": { "$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/sha256" },
        "manifest_hash": { "$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/sha256" }
      }
    },
    "human_interventions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["occurred_at", "actor_id", "description"],
        "properties": {
          "occurred_at": { "$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/timestamp" },
          "actor_id": { "$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/identifier" },
          "description": { "type": "string", "minLength": 1 },
          "directional": { "type": "boolean" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "required": ["trial_binding"] },
      "then": { "required": ["budget_policy_hash"] }
    }
  ]
}
