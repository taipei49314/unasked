{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.unasked.dev/v0.1/review.schema.json",
  "title": "UNASKED independent review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "candidate_id",
    "run_id",
    "review_type",
    "reviewed_at",
    "reviewer",
    "conclusion",
    "findings",
    "evidence_hashes"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "review_id": { "$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/identifier" },
    "candidate_id": { "$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/identifier" },
    "run_id": { "$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/identifier" },
    "review_type": { "enum": ["COUNTEREVIDENCE", "NOVELTY", "MATERIALITY", "KNOWN_ISSUE"] },
    "reviewed_at": { "$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/timestamp" },
    "reviewer": { "$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/actor" },
    "conclusion": { "enum": ["PASS", "FAIL", "INCONCLUSIVE"] },
    "findings": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "evidence_hashes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/sha256" },
      "uniqueItems": true
    },
    "knowledge_boundary_hash": { "$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/sha256" },
    "tested_alternatives": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "negative_control": { "type": "string", "minLength": 1 },
    "semantic_variant": { "type": "string", "minLength": 1 },
    "completeness_check": { "type": "string", "minLength": 1 },
    "challenge_attempts": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["attempt_id", "attempt_type", "description", "predeclared_input_hash", "result_ref", "observed_outcome"],
        "properties": {
          "attempt_id": { "$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/identifier" },
          "attempt_type": { "enum": ["BENIGN_ALTERNATIVE", "NEGATIVE_CONTROL", "SEMANTIC_VARIANT", "COMPLETENESS_CHECK"] },
          "description": { "type": "string", "minLength": 1 },
          "predeclared_input_hash": { "$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/sha256" },
          "result_ref": { "$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/artifactReference" },
          "observed_outcome": { "enum": ["SURVIVED", "REFUTED", "INCONCLUSIVE"] }
        }
      }
    },
    "decision_impact": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": {
        "properties": { "review_type": { "const": "COUNTEREVIDENCE" } },
        "required": ["review_type"]
      },
      "then": {
        "required": ["tested_alternatives", "negative_control", "semantic_variant", "completeness_check", "challenge_attempts"]
      }
    },
    {
      "if": {
        "properties": { "review_type": { "enum": ["NOVELTY", "KNOWN_ISSUE"] } },
        "required": ["review_type"]
      },
      "then": { "required": ["knowledge_boundary_hash"] }
    },
    {
      "if": {
        "properties": { "review_type": { "const": "MATERIALITY" } },
        "required": ["review_type"]
      },
      "then": { "required": ["decision_impact"] }
    }
  ]
}
