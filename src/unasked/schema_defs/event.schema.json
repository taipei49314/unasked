{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.unasked.dev/v0.1/event.schema.json",
  "title": "UNASKED append-only ledger event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "run_id",
    "sequence",
    "occurred_at",
    "event_type",
    "actor",
    "payload",
    "artifact_refs",
    "previous_event_hash",
    "event_hash"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "event_id": { "$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/identifier" },
    "run_id": { "$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/identifier" },
    "sequence": { "type": "integer", "minimum": 0 },
    "occurred_at": { "$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/timestamp" },
    "event_type": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
    "actor": { "$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/actor" },
    "payload": { "type": "object" },
    "artifact_refs": {
      "type": "array",
      "items": { "$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/artifactReference" }
    },
    "previous_event_hash": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/sha256" }
      ]
    },
    "event_hash": { "$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/sha256" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "sequence": { "const": 0 } },
        "required": ["sequence"]
      },
      "then": {
        "properties": { "previous_event_hash": { "type": "null" } }
      },
      "else": {
        "properties": {
          "previous_event_hash": { "$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/sha256" }
        }
      }
    },
    {
      "if": {
        "properties": { "event_type": { "const": "STATE_TRANSITION" } },
        "required": ["event_type"]
      },
      "then": {
        "properties": {
          "payload": {
            "required": ["candidate_id", "from_state", "to_state"],
            "properties": {
              "candidate_id": { "$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/identifier" },
              "from_state": { "$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/lifecycleState" },
              "to_state": { "$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/lifecycleState" }
            }
          }
        }
      }
    }
  ]
}
