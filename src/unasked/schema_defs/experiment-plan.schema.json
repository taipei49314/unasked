{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.unasked.dev/v0.1/experiment-plan.schema.json",
  "title": "UNASKED replayable experiment plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "hypothesis_id",
    "run_id",
    "created_at",
    "protocol_hash",
    "snapshot_hash",
    "isolation",
    "commands",
    "outcome_criteria",
    "outcome_assertions",
    "required_capabilities",
    "planner"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "plan_id": { "$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/identifier" },
    "hypothesis_id": { "$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/identifier" },
    "run_id": { "$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/identifier" },
    "created_at": { "$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/timestamp" },
    "protocol_hash": { "$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/sha256" },
    "snapshot_hash": { "$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/sha256" },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worktree", "network", "secret_free", "mutation_scope", "limits"],
      "properties": {
        "worktree": { "const": "ISOLATED" },
        "network": { "const": "DISABLED" },
        "secret_free": { "const": true },
        "mutation_scope": { "enum": ["READ_ONLY", "SANDBOX_ONLY"] },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpu_seconds", "wall_seconds", "disk_bytes", "processes"],
          "properties": {
            "cpu_seconds": { "type": "integer", "minimum": 1 },
            "wall_seconds": { "type": "integer", "minimum": 1 },
            "disk_bytes": { "type": "integer", "minimum": 1 },
            "processes": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command_id", "argv", "purpose", "expected_observation"],
        "properties": {
          "command_id": { "$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/identifier" },
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "working_directory": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "expected_observation": { "type": "string", "minLength": 1 }
        }
      }
    },
    "outcome_criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": ["support", "falsify", "inconclusive"],
      "properties": {
        "support": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "falsify": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "inconclusive": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "outcome_assertions": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assertion_id", "command_id", "field", "operator", "expected", "classification"],
        "properties": {
          "assertion_id": { "$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/identifier" },
          "command_id": { "$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/identifier" },
          "field": { "enum": ["EXIT_CODE", "STDOUT_SHA256", "STDERR_SHA256", "DIFF_SHA256"] },
          "operator": { "const": "EQUALS" },
          "expected": {
            "oneOf": [
              { "type": "integer" },
              { "$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/sha256" }
            ]
          },
          "classification": { "enum": ["SUPPORTS", "FALSIFIES"] }
        }
      }
    },
    "required_capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/capability" },
      "contains": { "const": "EXECUTE_SANDBOX" },
      "uniqueItems": true
    },
    "planner": {
      "allOf": [
        { "$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/actor" },
        {
          "properties": {
            "role": { "const": "EXPERIMENT_PLANNER" },
            "capabilities": { "contains": { "const": "REQUEST_EXPERIMENT" } }
          }
        }
      ]
    }
  }
}
