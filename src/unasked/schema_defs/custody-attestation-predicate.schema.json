  "properties": {
    "schema_version": {"const": "0.4.0"}, "predicate_id": {"$ref": "#/$defs/id"}, "issued_at": {"$ref": "#/$defs/time"}, "issuer_actor_id": {"$ref": "#/$defs/id"}, "trust_policy_sha256": {"$ref": "#/$defs/hash"},
    "suite_id": {"$ref": "#/$defs/id"}, "manifest_sha256": {"$ref": "#/$defs/hash"}, "case_commitment_sha256": {"$ref": "#/$defs/hash"}, "sealed_at": {"$ref": "#/$defs/time"}, "explorer_development_started_at": {"$ref": "#/$defs/time"}, "independent_custody": {"type": "boolean"}, "sealed_before_explorer": {"type": "boolean"}, "hidden_case_count": {"type": "integer", "minimum": 0}, "positive_case_count": {"type": "integer", "minimum": 0}, "control_case_count": {"type": "integer", "minimum": 0}, "explorer_ground_truth_access": {"type": "boolean"}, "evaluator_access": {"type": "boolean"}, "directional_steering": {"type": "boolean"}
  },
  "$defs": {"id": {"$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/identifier"}, "hash": {"$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/sha256"}, "time": {"$ref": "https://schemas.unasked.dev/v0.1/common.schema.json#/$defs/timestamp"}}
}
