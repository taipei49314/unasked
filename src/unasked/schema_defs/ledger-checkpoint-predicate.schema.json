    "suite_id": {"$ref": "#/$defs/id"}, "case_id": {"$ref": "#/$defs/id"}, "variant": {"$ref": "#/$defs/variant"}, "run_id": {"$ref": "#/$defs/id"}, "entry_count": {"type": "integer", "minimum": 1}, "head_event_hash": {"$ref": "#/$defs/hash"}, "ledger_sha256": {"$ref": "#/$defs/hash"}, "target_snapshot_hash": {"$ref": "#/$defs/hash"}, "protocol_hash": {"$ref": "#/$defs/hash"}, "checkpointed_at": {"$ref": "#/$defs/time"}
