    "thresholds": {"type": "object", "additionalProperties": false, "required": ["positive_cases_required", "positive_cases_total", "control_false_verified_max", "clean_replay_rate_required", "run_count_required", "variant_count_required", "case_count_required"], "properties": {"positive_cases_required": {"const": 3}, "positive_cases_total": {"const": 5}, "control_false_verified_max": {"const": 0}, "clean_replay_rate_required": {"const": "1.000000"}, "run_count_required": {"const": 35}, "variant_count_required": {"const": 5}, "case_count_required": {"const": 7}}},
